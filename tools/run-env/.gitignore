# Everything here is regenerable. 177 KB of source builds 300 MB of output;
# committing the output would make the tree unreviewable to save two commands.
#
#   ./fetch-engine.sh     -> v86-m1/      (~10 MB, hash-verified against the pins)
#   ./build-guest.sh      -> alpine-guest/guest/ + the build/bios/vendor symlinks
#   ./build-kernel.sh     -> kernel-min/  (~1.6 MB, 7 min)

v86-m1/
kernel-min/
alpine-guest*/guest/

# the package-signing key (package-key.sh). NEVER COMMITTED; back it up.
.keys/
alpine-guest*/build
alpine-guest*/bios
alpine-guest*/vendor

# scratch outdirs from A/B runs (build-guest.sh takes an outdir argument)
alpine-guest-*/
!alpine-guest/

# harness variants generated while bisecting a boot
alpine-guest/boot-ni-*.js
alpine-guest/boot-noinitrd.js

# ./package-app.sh output (the entity-app dist: page + asset bundles)
app-dist*/
# package-survey.py: cached Alpine indexes
.survey/

# kolibri/fetch-image.sh output (the pinned floppy image, its snapshot) and the
# engine links it makes. The vm-sdk links in both page directories ARE committed.
kolibri/guest/
kolibri/build
kolibri/bios
kolibri/.build/
