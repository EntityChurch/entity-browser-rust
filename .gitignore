/target
/dist
/dist-papers
# Output-isolated dirs for the publish-* family so it runs concurrently with
# tauri-run without clobbering dist/ + target/ (Makefile DIST/TARGET_DIR).
/dist-publish
/target-publish
# Transient staging dirs for `make tauri-bundle` — the recipe copies an external
# APPS_DIST / INGEST here so the publish container (which mounts only this repo)
# can see them, then removes them. Never committed.
/.apps-stage
/.ingest-stage
# Durable publisher identity (Makefile PUBLISH_DATA_DIR / ENTITY_DATA_DIR) — a
# private keypair; NEVER commit it.
/.entity-publish
# Cargo.lock is COMMITTED (both of them). This repo ships binaries, not a
# library, and a release build must be reproducible: without the lockfile the
# same tag resolves different transitive versions on different days. Un-ignored
# 2026-08-17 as part of the release runway (RELEASE-READINESS §8).
src-tauri/target/

# Per-machine podman resource-cap overrides (RESOURCE-CAPS.md §4a) — never committed.
caps.local.mk
.tauri-home/
.cache/

# Python bytecode from tooling scripts
__pycache__/
*.pyc

# Release artifacts (make dist / dist-web) — built, never committed.
/artifacts
